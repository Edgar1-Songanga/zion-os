# Server-side API configuration. Never commit real secrets.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
PORT=3000

# Production CORS allow-list (comma-separated origins).
ZION_ALLOWED_ORIGINS=https://zion-os-omega.vercel.app

# Transactional notification email provider
ZION_NOTIFICATION_EMAIL_FROM=ZION OS <notifications@yourdomain.com>
RESEND_API_KEY=re_your_server_side_key

# Shared MARKA × ZION AI Core (server-side only)
AI_CORE_BASE_URL=https://marka-zion-ai-core.vercel.app
AI_CORE_API_KEY=
AI_CONTEXT_SIGNING_SECRET=
AI_CORE_VERCEL_BYPASS=
AI_CONTEXT_ISSUER=zion-api
AI_CONTEXT_AUDIENCE=ai-core
AI_CORE_SPACE=zion
