{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "pnpm --filter api build",
  "outputDirectory": "api-public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index?__zion_path=:path*"
    }
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  }
}
